# Environment Configuration for Zeenat Pakistan Fashion E-Commerce

# Flask Secret Key for session signing
SECRET_KEY=zeenat-luxury-pret-super-secret-key-2026

# Database URI (Defaults to local SQLite, or replace with PostgreSQL for production)
# Example PostgreSQL: postgresql://username:password@localhost:5432/zeenat_db
DATABASE_URL=sqlite:///zeenat.db

# Flask Environment (development / production)
FLASK_ENV=development
PORT=5000

# Payment Gateway Configuration (Optional - Stripe / Bank)
# If provided, enables live 3D-secure card payments via official Stripe API.
# If omitted, application defaults cleanly to nationwide Cash on Delivery (COD) & IBFT.
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Store Shipping Rules
FREE_SHIPPING_THRESHOLD=3500.0
DEFAULT_SHIPPING_FEE=200.0
